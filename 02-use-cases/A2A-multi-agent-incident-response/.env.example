# =============================================================================
# A2A Multi-Agent Incident Response — Environment Configuration
# =============================================================================
# Copy this file to .a2a.config and fill in your values.
# The deploy.py script will prompt for these interactively if not set.
# NEVER commit actual secrets to version control.
# =============================================================================

# --- AWS Configuration ---
AWS_REGION=us-west-2

# --- API Keys (get your own) ---
# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key

# Tavily (web search): https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key

# --- Model Configuration ---
# Host Agent (runs on AgentCore Runtime via LiteLLM)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-20250514-v1:0

# Monitor Agent (Strands on AgentCore Runtime)
MONITOR_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Web Search Agent (Strands on GCP Cloud Run)
WEBSEARCH_MODEL_ID=gemini/gemini-2.5-flash

# --- Gmail 3LO (Optional — for email feature) ---
# Google Cloud Console: https://console.developers.google.com/
# 1. Create OAuth 2.0 credentials (Web application)
# 2. Enable Gmail API
# 3. Add test users in OAuth consent screen
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Gmail credential provider name (created by setup script)
GMAIL_PROVIDER_NAME=gmail-3lo-provider

# OAuth2 callback URL (for session binding)
CALLBACK_URL=http://localhost:9090/oauth2/callback

# --- GCP Cloud Run (Web Search Agent) ---
# Set after deploying the web search agent to GCP
WEBSEARCH_GCP_URL=https://your-web-search-agent.us-central1.run.app
